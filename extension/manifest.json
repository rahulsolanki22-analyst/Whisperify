{
  "manifest_version": 3,
  "name": "Whisperify",
  "version": "1.0.0",
  "description": "Synced lyric provider fallback for Spotify Web Player and YouTube watch pages utilizing text APIs.",
  "permissions": [
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:8080/*",
    "https://whisperify-2.onrender.com/*",
    "*://open.spotify.com/*",
    "*://*.spotify.com/*",
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
